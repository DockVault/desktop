# Dependencies
node_modules/

# Build / packaging output (but keep the committed app-icon source under build/)
dist/
out/
build/*
!build/icon.png
!build/entitlements.mac.plist
!build/installer.nsh
!build/rclone.json
release/
*.asar

# Local-only runtime data, scratch, captured evidence — never committed
.local/

# Git bundles and their drop dir — branch-history snapshots shared out-of-band, never committed
*.bundle
/results/

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp

# Tooling / scan artifacts (stray local state, never committed)
.semgrep/
